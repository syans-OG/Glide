{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glide",
  "version": "1.0.0",
  "identifier": "com.glide.remote",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Glide — Presentation Remote",
        "width": 380,
        "height": 380,
        "resizable": false,
        "decorations": false,
        "center": true,
        "transparent": false,
        "shadow": true
      },
      {
        "label": "overlay",
        "title": "",
        "url": "overlay.html",
        "fullscreen": false,
        "maximized": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ws://localhost:8765 ws://127.0.0.1:8765; img-src 'self' data:; font-src 'self' data:",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
